# Resend (server-side only - never prefix with VITE_). Also set these in Vercel > Settings > Environment Variables.
RESEND_API_KEY=your_resend_api_key
CONTACT_TO_EMAIL=you@example.com
# Optional: verified sender once you add a domain in Resend (default is onboarding@resend.dev)
# CONTACT_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
# Optional: extra allowed origins, comma separated (your own site origin is allowed automatically)
# ALLOWED_ORIGINS=https://www.yourdomain.com
